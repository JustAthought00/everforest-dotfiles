/* Inspired by HyprNova's card layouts;
    independent Everforest palette. */
configuration {
    font: "Adwaita Sans 12";
    show-icons: true;
    icon-theme: "Papirus-Dark";
    hover-select: true;
    scroll-method: 0;
    click-to-exit: true;
}
* {
    bg: #2d353bf5;
    surface: #343f44;
    raised: #3d484d;
    selected-bg: #414d43;
    foreground: #d3c6aa;
    muted: #9da9a0;
    accent: #a7c080;
    outline: #475258;
    background-color: transparent;
    text-color: @foreground;
    border-color: @outline;
}
window {
    location: center;
    anchor: center;
    width: 840px;
    border: 1px;
    border-color: @outline;
    border-radius: 24px;
    background-color: @bg;
    padding: 0;
}
mainbox {
    children: [ "header", "inputbar", "listview", "message", "textbox-help" ];
    spacing: 18px;
    padding: 28px;
    background-color: transparent;
}
header {
    children: [ "textbox-heading", "textbox-badge" ];
    orientation: horizontal;
    spacing: 16px;
}
textbox-badge {
    expand: false;
    content: "EVERFOREST";
    font: "Adwaita Sans Bold 9";
    text-color: @accent;
    background-color: @selected-bg;
    padding: 9px 12px;
    border-radius: 10px;
    vertical-align: 0.5;
}
inputbar {
    children: [ "prompt", "entry" ];
    spacing: 12px;
    padding: 14px 16px;
    border-radius: 12px;
    background-color: @surface;
}
prompt { text-color: @accent;
    font: "JetBrainsMono Nerd Font 13";
    }
entry { placeholder: "Search your clipboard…";
    placeholder-color: @muted;
    }
listview {
    lines: 8;
    columns: 1;
    spacing: 7px;
    fixed-height: true;
    dynamic: false;
    scrollbar: false;
    cycle: true;
}
element {
    padding: 12px 14px;
    spacing: 12px;
    border: 1px;
    border-color: transparent;
    border-radius: 12px;
    background-color: @surface;
    cursor: pointer;
}
element selected.normal, element selected.active, element selected.urgent {
    background-color: @selected-bg;
    border-color: @accent;
    text-color: @foreground;
}
element-icon { size: 24px;
    }
element-text { vertical-align: 0.5;
    }
message { padding: 0;
    }
textbox { text-color: @muted;
    }
textbox-help {
    content: "Enter  Select     ·     Esc  Close";
    font: "Adwaita Sans 10";
    text-color: @muted;
    padding: 6px 0 0;
}
error-message { background-color: @bg;
    padding: 20px;
    }

/* Keep headings and hints at their natural height. */
header { expand: false; }
inputbar { expand: false; }
message { expand: false; }
textbox-help { expand: false; }
listview { layout: vertical; }
element { children: [ "element-icon", "element-text" ]; }
mainbox { orientation: vertical; }
textbox-heading {
    expand: true;
    markup: true;
    font: "Adwaita Sans 16";
    content: "<b>Clipboard history</b>&#10;<span size='small' foreground='#9da9a0'>Your recent copies, ready to use</span>";
}
